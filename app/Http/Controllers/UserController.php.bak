<?php

namespace App\Http\Controllers;

use App\Models\User;
use Illuminate\Http\Request;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Storage;

class UserController extends Controller
{
    public function postSingUp(Request $request)
    {
        $validated = $request->validate([
            'email' => 'required|email|unique:users',
            'first-name' => 'required|max:120',
            'password' => 'required|min:6',
        ]);

        $user = new User();
        $user->email = $validated['email'];
        $user->first_name = $validated['first-name'];
        $user->password = Hash::make($validated['password']);
        $user->save();

        Auth::login($user);

        return redirect()->route('dashboard');
    }

    public function postSingIn(Request $request)
    {
        $credentials = $request->validate([
            'email' => 'required|email',
            'password' => 'required',
        ]);

        if (Auth::attempt($credentials)) {
            $request->session()->regenerate();

            return redirect()->route('dashboard');
        }

        return redirect()->back();
    }

    public function getLogout()
    {
        Auth::logout();

        return redirect()->route('home');
    }

    public function getAccount()
    {
        return view('account', ['user' => Auth::user()]);
    }

    public function postSaveAccount(Request $request)
    {
        $validated = $request->validate([
            'first_name' => 'required|max:120',
        ]);

        $user = Auth::user();
        $user->first_name = $validated['first_name'];
        $user->update();

        $file = $request->file('image');
        $filename = $validated['first_name'].'-'.$user->id.'.jpg';

        if ($file) {
            Storage::disk('local')->put($filename, File::get($file));
        }

        return redirect()->route('account');
    }

    public function getUserImage($filename)
    {
        abort_unless(Storage::disk('local')->exists($filename), 404);

        $file = Storage::disk('local')->get($filename);

        return new Response($file, 200);
    }
}
